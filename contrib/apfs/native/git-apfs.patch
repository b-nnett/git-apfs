@@ -0,0 +1,622 @@
+/* APFS checkout optimization. Distributed under Git's GPL version 2. */
+#define USE_THE_REPOSITORY_VARIABLE
+#include "git-compat-util.h"
+#include "apfs-checkout.h"
+#include "config.h"
+#include "abspath.h"
+#include "convert.h"
+#include "entry.h"
+#include "hex.h"
+#include "object-store.h"
+#include "object-file.h"
+#include "replace-object.h"
+#include "parse.h"
+#include "parallel-checkout.h"
+#include "read-cache-ll.h"
+#include "tree-walk.h"
+#include "worktree.h"
+#include "thread-utils.h"
+
+#ifdef __APPLE__
+#include <sys/clonefile.h>
+#include <sys/xattr.h>
+#include <sys/mount.h>
+#include <sys/resource.h>
+
+static struct worktree **donors;
+static int initialized, enabled, trace_enabled;
+static mode_t checkout_umask;
+static uintmax_t attempted, cloned_files, cloned_bytes, batches;
+static int batch_workers;
+struct donor_directory {
+	int fd;
+	const char *root;
+	char *path;
+	size_t len;
+};
+
+static struct donor_directory main_source_dir = { .fd = -1 };
+
+static void clear_donor_directory(struct donor_directory *cache)
+{
+	if (cache->fd >= 0)
+		close(cache->fd);
+	free(cache->path);
+	cache->fd = -1;
+	cache->path = NULL;
+}
+
+static void report_clones(void)
+{
+	if (trace_enabled)
+		fprintf(stderr, "git-apfs: attempted=%"PRIuMAX" cloned=%"PRIuMAX" bytes=%"PRIuMAX"\n",
+			attempted, cloned_files, cloned_bytes);
+	if (trace_enabled && batches)
+		fprintf(stderr, "git-apfs-batch: batches=%"PRIuMAX" workers=%d\n",
+			batches, batch_workers);
+	clear_donor_directory(&main_source_dir);
+	free_worktrees(donors);
+}
+
+static void initialize(void)
+{
+	if (!initialized) {
+		initialized = 1;
+		enabled = 1;
+		git_config_get_bool("apfs.clonecheckout", &enabled);
+		enabled = git_env_bool("GIT_APFS_CLONE_CHECKOUT", enabled);
+		trace_enabled = git_env_bool("GIT_APFS_TRACE", 0);
+		checkout_umask = umask(0);
+		umask(checkout_umask);
+		if (enabled) {
+			donors = get_worktrees_without_reading_head();
+			atexit(report_clones);
+		}
+	}
+}
+
+/* Keep native settings outside eligible APFS worktree repositories. Explicit
+ * checkout.workers and threshold settings always take precedence. */
+int apfs_checkout_default_workers(void)
+{
+	struct statfs fs;
+	struct stat current, donor;
+	int i;
+
+	initialize();
+	if (!enabled || !donors || statfs(".", &fs) ||
+	    strcmp(fs.f_fstypename, "apfs") || stat(".", &current))
+		return 1;
+	for (i = 0; donors[i]; i++) {
+		if (!donors[i]->is_current && !donors[i]->is_bare &&
+		    !lstat(donors[i]->path, &donor) && S_ISDIR(donor.st_mode) &&
+		    donor.st_dev == current.st_dev)
+			return online_cpus() < 8 ? online_cpus() : 8;
+	}
+	return 1;
+}
+
+static int unchanged(const struct stat *a, const struct stat *b)
+{
+	return a->st_dev == b->st_dev && a->st_ino == b->st_ino &&
+		a->st_size == b->st_size && a->st_mode == b->st_mode &&
+		a->st_uid == b->st_uid && a->st_gid == b->st_gid &&
+		a->st_flags == b->st_flags &&
+		a->st_mtimespec.tv_sec == b->st_mtimespec.tv_sec &&
+		a->st_mtimespec.tv_nsec == b->st_mtimespec.tv_nsec &&
+		a->st_ctimespec.tv_sec == b->st_ctimespec.tv_sec &&
+		a->st_ctimespec.tv_nsec == b->st_ctimespec.tv_nsec;
+}
+
+/* Pin every directory component; never follow a donor/target ancestor link. */
+static int parent_fd(const char *root, const char *relative, const char **name)
+{
+	int fd = open(root, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	char *copy, *p, *slash;
+	if (fd < 0)
+		return -1;
+	if (!*relative || is_absolute_path(relative)) {
+		close(fd);
+		return -1;
+	}
+	copy = xstrdup(relative);
+	p = copy;
+	while ((slash = strchr(p, '/'))) {
+		int next;
+		*slash = '\0';
+		if (!*p || !strcmp(p, ".") || !strcmp(p, "..")) {
+			close(fd);
+			free(copy);
+			return -1;
+		}
+		next = openat(fd, p, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+		close(fd);
+		if (next < 0) {
+			free(copy);
+			return -1;
+		}
+		fd = next;
+		p = slash + 1;
+	}
+	free(copy);
+	*name = strrchr(relative, '/');
+	*name = *name ? *name + 1 : relative;
+	if (!**name || !strcmp(*name, ".") || !strcmp(*name, "..")) {
+		close(fd);
+		return -1;
+	}
+	return fd;
+}
+
+/* Only donor directories are cached. A pinned former donor directory remains
+ * safe because every source is byte-verified. Target ancestors are always
+ * walked afresh, so writes cannot disappear into a cached detached directory. */
+static int donor_parent_fd(struct donor_directory *cache, const char *root,
+			   const char *path, const char **name)
+{
+	const char *slash = strrchr(path, '/');
+	size_t len = slash ? slash - path : 0;
+	int fd;
+
+	*name = slash ? slash + 1 : path;
+	if (cache->fd >= 0 && root == cache->root &&
+	    len == cache->len && !strncmp(path, cache->path, len))
+		return cache->fd;
+	fd = parent_fd(root, path, name);
+	if (fd < 0)
+		return -1;
+	if (cache->fd >= 0)
+		close(cache->fd);
+	free(cache->path);
+	cache->path = xmemdupz(path, len);
+	cache->root = root;
+	cache->len = len;
+	cache->fd = fd;
+	return fd;
+}
+
+static int matches_blob(int fd, const char *expected, size_t size)
+{
+	char buffer[65536];
+	size_t offset = 0;
+	while (offset < size) {
+		size_t wanted = size - offset;
+		ssize_t got;
+		if (wanted > sizeof(buffer))
+			wanted = sizeof(buffer);
+		got = read_in_full(fd, buffer, wanted);
+		if (got != wanted || memcmp(buffer, expected + offset, wanted))
+			return 0;
+		offset += wanted;
+	}
+	return 1;
+}
+
+/* For small files, use Git's canonical blob identity without decompressing
+ * the expected object body again. Object type/size are checked separately;
+ * replacement objects and the repository hash algorithm are respected. */
+static int matches_small_blob(int fd, size_t size, const struct object_id *oid,
+			      const struct git_hash_algo *algo)
+{
+	struct git_hash_ctx ctx;
+	struct object_id actual;
+	char header[32], buffer[65536];
+	int len = format_object_header(header, sizeof(header), OBJ_BLOB, size);
+
+	algo->init_fn(&ctx);
+	git_hash_update(&ctx, header, len);
+	if (read_in_full(fd, buffer, size) != size)
+		return 0;
+	git_hash_update(&ctx, buffer, size);
+	git_hash_final_oid(&actual, &ctx);
+	return oideq(&actual, oid);
+}
+
+struct clone_plan {
+	int small_task;
+	const char *path;
+	struct object_id expected_oid;
+	const struct git_hash_algo *hash_algo;
+	int source, parent;
+	const char *name;
+	struct stat before, st;
+	size_t size;
+	mode_t mode;
+	char temporary[96];
+	int result, saved_errno;
+};
+
+static int prepare_clone(const struct cache_entry *ce, const char *path,
+		       const struct conv_attrs *ca,
+		       const struct checkout *state, struct clone_plan *plan)
+{
+	struct stat before, after;
+	const char *name;
+	char *blob = NULL;
+	size_t size = 0;
+	int parent = -1, i, object_checked = 0;
+
+	plan->small_task = 0;
+	/* Git retains responsibility for conversions, filters, links and prefixes. */
+	if (!ca || ca->drv || ca->ident || ca->working_tree_encoding ||
+	    ca->crlf_action != CRLF_BINARY || state->base_dir_len ||
+	    strcmp(path, ce->name) || !S_ISREG(ce->ce_mode))
+		return 0;
+	initialize();
+	if (!enabled || !donors)
+		return 0;
+	attempted++;
+	for (i = 0; donors[i]; i++) {
+		const char *source_name;
+		int source_parent, source;
+		/* The bytes, not donor HEAD/index metadata, establish correctness.
+		 * Avoid re-reading commit/tree objects for every checkout entry. */
+		if (donors[i]->is_current || donors[i]->is_bare)
+			continue;
+		source_parent = donor_parent_fd(&main_source_dir, donors[i]->path, ce->name, &source_name);
+		if (source_parent < 0)
+			continue;
+		source = openat(source_parent, source_name,
+				O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+		if (source < 0)
+			continue;
+		if (fstat(source, &before) || !S_ISREG(before.st_mode) ||
+		    before.st_flags || !(before.st_mode & S_IRUSR) || before.st_size <= 0 ||
+		    before.st_size > 64 * 1024 * 1024 ||
+		    flistxattr(source, NULL, 0, 0) != 0) {
+			close(source);
+			continue;
+		}
+		if (!object_checked) {
+			unsigned long object_size;
+			if (oid_object_info(the_repository, &ce->oid, &object_size) != OBJ_BLOB ||
+			    object_size > 64 * 1024 * 1024) {
+				close(source);
+				break;
+			}
+			object_checked = 1;
+			size = object_size;
+		}
+		if (before.st_size != size) {
+			close(source);
+			continue;
+		}
+		if (size <= 65536) {
+			if (!matches_small_blob(source, size,
+				lookup_replace_object(the_repository, &ce->oid),
+				the_repository->hash_algo)) {
+				close(source);
+				continue;
+			}
+		} else {
+			if (!blob)
+				blob = read_blob_entry(ce, &size);
+			if (!blob) {
+				close(source);
+				break;
+			}
+			if (before.st_size != size || !matches_blob(source, blob, size)) {
+				close(source);
+				continue;
+			}
+		}
+		if (fstat(source, &after) || !unchanged(&before, &after)) {
+			close(source);
+			continue;
+		}
+		if (parent < 0)
+			parent = parent_fd(".", path, &name);
+		if (parent < 0) {
+			close(source);
+			break;
+		}
+		plan->source = source;
+		plan->parent = parent;
+		plan->name = name;
+		plan->before = before;
+		plan->size = size;
+		plan->mode = ((ce->ce_mode & 0100) ? 0777 : 0666) & ~checkout_umask;
+		{
+			uint64_t nonce[2];
+			if (csprng_bytes(nonce, sizeof(nonce), 0) < 0) {
+				close(source);
+				break;
+			}
+			xsnprintf(plan->temporary, sizeof(plan->temporary),
+				  ".git-apfs-%"PRIx64"-%"PRIx64, nonce[0], nonce[1]);
+		}
+		free(blob);
+		return 1;
+	}
+	if (parent >= 0)
+		close(parent);
+	free(blob);
+	return 0;
+}
+
+/* Descriptor operations and independent hash contexts run in threads. Git's object
+ * store, configuration, index and trace counters stay on the main thread. */
+static void execute_clone(struct clone_plan *plan)
+{
+	struct stat created, current, after;
+	int output = -1, published = 0, have_created = 0;
+
+	plan->result = 0;
+	if (fclonefileat(plan->source, plan->parent, plan->temporary, CLONE_NOOWNERCOPY))
+		goto out;
+	have_created = !fstatat(plan->parent, plan->temporary, &created, AT_SYMLINK_NOFOLLOW);
+	output = openat(plan->parent, plan->temporary, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (have_created && output >= 0 && !fstat(output, &current) &&
+	    current.st_dev == created.st_dev && current.st_ino == created.st_ino &&
+	    !fstat(plan->source, &after) && unchanged(&plan->before, &after) &&
+	    ((current.st_mode & 07777) == plan->mode || !fchmod(output, plan->mode)) &&
+	    !renameatx_np(plan->parent, plan->temporary, plan->parent, plan->name, RENAME_EXCL)) {
+		published = 1;
+		if (!futimens(output, NULL) && !fstat(output, &plan->st)) {
+			if (plan->size) {
+				struct radvisory advice = { 0, (int)plan->size };
+				fcntl(output, F_RDADVISE, &advice);
+			}
+			plan->result = 1;
+		} else {
+			/* Never retry a write after publishing its output. */
+			plan->result = -1;
+			plan->saved_errno = errno;
+		}
+	}
+	if (!published && have_created &&
+	    !fstatat(plan->parent, plan->temporary, &current, AT_SYMLINK_NOFOLLOW) &&
+	    current.st_dev == created.st_dev && current.st_ino == created.st_ino)
+		unlinkat(plan->parent, plan->temporary, 0);
+ out:
+	if (output >= 0)
+		close(output);
+	close(plan->source);
+	close(plan->parent);
+}
+
+/* This preflight touches Git metadata only on the caller. Filesystem reads,
+ * hash contexts and clone descriptors are independent for each worker. */
+static int prepare_small_task(const struct cache_entry *ce,
+			      const struct conv_attrs *ca,
+			      const struct checkout *state, struct clone_plan *plan)
+{
+	unsigned long size;
+	uint64_t nonce[2];
+
+	if (!ca || ca->drv || ca->ident || ca->working_tree_encoding ||
+	    ca->crlf_action != CRLF_BINARY || state->base_dir_len ||
+	    !S_ISREG(ce->ce_mode) ||
+	    oid_object_info(the_repository, &ce->oid, &size) != OBJ_BLOB ||
+	    !size || size > 65536 || csprng_bytes(nonce, sizeof(nonce), 0) < 0)
+		return 0;
+	plan->small_task = 1;
+	plan->path = ce->name;
+	plan->size = size;
+	plan->mode = ((ce->ce_mode & 0100) ? 0777 : 0666) & ~checkout_umask;
+	plan->hash_algo = the_repository->hash_algo;
+	oidcpy(&plan->expected_oid, lookup_replace_object(the_repository, &ce->oid));
+	xsnprintf(plan->temporary, sizeof(plan->temporary),
+		  ".git-apfs-%"PRIx64"-%"PRIx64, nonce[0], nonce[1]);
+	attempted++;
+	return 1;
+}
+
+static void execute_plan(struct clone_plan *plan, struct donor_directory *cache)
+{
+	int i;
+
+	if (!plan->small_task) {
+		execute_clone(plan);
+		return;
+	}
+	plan->result = 0;
+	for (i = 0; donors[i]; i++) {
+		const char *source_name;
+		struct stat before, after;
+		int parent, source;
+
+		if (donors[i]->is_current || donors[i]->is_bare)
+			continue;
+		parent = donor_parent_fd(cache, donors[i]->path, plan->path, &source_name);
+		if (parent < 0)
+			continue;
+		source = openat(parent, source_name, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+		if (source < 0)
+			continue;
+		if (fstat(source, &before) || !S_ISREG(before.st_mode) ||
+		    before.st_flags || !(before.st_mode & S_IRUSR) ||
+		    before.st_size != plan->size || flistxattr(source, NULL, 0, 0) != 0 ||
+		    !matches_small_blob(source, plan->size, &plan->expected_oid, plan->hash_algo) ||
+		    fstat(source, &after) || !unchanged(&before, &after)) {
+			close(source);
+			continue;
+		}
+		parent = parent_fd(".", plan->path, &plan->name);
+		if (parent < 0) {
+			close(source);
+			return;
+		}
+		plan->source = source;
+		plan->parent = parent;
+		plan->before = before;
+		execute_clone(plan);
+		if (plan->result)
+			return;
+	}
+}
+
+static void count_clone(const struct clone_plan *plan)
+{
+	if (plan->result > 0) {
+		cloned_files++;
+		cloned_bytes += plan->size;
+	}
+}
+
+int apfs_checkout_clone(const struct cache_entry *ce, const char *path,
+		       const struct conv_attrs *ca,
+		       const struct checkout *state, struct stat *st)
+{
+	struct clone_plan plan;
+	if (!prepare_clone(ce, path, ca, state, &plan))
+		return 0;
+	execute_clone(&plan);
+	count_clone(&plan);
+	if (plan.result > 0)
+		*st = plan.st;
+	else if (plan.result < 0)
+		errno = plan.saved_errno;
+	return plan.result;
+}
+
+#ifndef NO_PTHREADS
+#define APFS_BATCH_SIZE 256
+#define APFS_MAX_WORKERS 8
+
+struct clone_batch {
+	struct clone_plan *plans;
+	int ready, next, finished;
+	pthread_mutex_t lock;
+	pthread_cond_t changed;
+};
+
+struct clone_worker {
+	struct clone_batch *batch;
+	struct donor_directory source_dir;
+};
+
+static void *clone_batch_worker(void *data)
+{
+	struct clone_worker *worker = data;
+	struct clone_batch *batch = worker->batch;
+	for (;;) {
+		int i;
+		pthread_mutex_lock(&batch->lock);
+		while (batch->next == batch->ready && !batch->finished)
+			pthread_cond_wait(&batch->changed, &batch->lock);
+		if (batch->next == batch->ready) {
+			pthread_mutex_unlock(&batch->lock);
+			clear_donor_directory(&worker->source_dir);
+			return NULL;
+		}
+		i = batch->next++;
+		pthread_mutex_unlock(&batch->lock);
+		execute_plan(&batch->plans[i], &worker->source_dir);
+	}
+}
+#endif
+
+int apfs_checkout_batch(struct parallel_checkout_item *items, size_t nr,
+			const struct checkout *state, int workers)
+{
+#ifndef NO_PTHREADS
+	size_t pos;
+	struct rlimit limit;
+	int capacity = APFS_BATCH_SIZE, handled = 0;
+
+	initialize();
+	if (state->base_dir_len || apfs_checkout_default_workers() <= 1)
+		return 0;
+	if (workers > APFS_MAX_WORKERS)
+		return 0;
+	if (!getrlimit(RLIMIT_NOFILE, &limit) && limit.rlim_cur != RLIM_INFINITY) {
+		if (limit.rlim_cur <= 64)
+			return 0;
+		if ((limit.rlim_cur - 64) / 3 < capacity)
+			capacity = (limit.rlim_cur - 64) / 3;
+		if (!capacity)
+			return 0;
+	}
+	/* Bound pinned descriptors, including on systems with low RLIMIT_NOFILE.
+	 * Object reads and all preparation remain serial and bounded per file. */
+	for (pos = 0; pos < nr; ) {
+		struct clone_plan plans[APFS_BATCH_SIZE];
+		struct parallel_checkout_item *prepared[APFS_BATCH_SIZE];
+		struct clone_batch batch = {
+			.plans = plans,
+			.lock = PTHREAD_MUTEX_INITIALIZER,
+			.changed = PTHREAD_COND_INITIALIZER
+		};
+		struct clone_worker jobs[APFS_MAX_WORKERS];
+		pthread_t threads[APFS_MAX_WORKERS];
+		int started[APFS_MAX_WORKERS] = { 0 };
+		int count = 0, i;
+
+		memset(jobs, 0, sizeof(jobs));
+		for (i = 0; i < workers; i++) {
+			jobs[i].batch = &batch;
+			jobs[i].source_dir.fd = -1;
+		}
+		for (; pos < nr && count < capacity; pos++) {
+			struct parallel_checkout_item *item = &items[pos];
+			if (!prepare_small_task(item->ce, &item->ca, state, &plans[count]) &&
+			    !prepare_clone(item->ce, item->ce->name, &item->ca,
+					   state, &plans[count]))
+				continue;
+			prepared[count++] = item;
+			if (count == 1) {
+				handled = 1;
+				batches++;
+				batch_workers = 1;
+				for (i = 1; i < workers; i++)
+					if (!pthread_create(&threads[i], NULL, clone_batch_worker, &jobs[i])) {
+						started[i] = 1;
+						batch_workers++;
+					}
+			}
+			/* Publish only completely prepared plans. Workers never access
+			 * Git objects while the main thread prepares the next file. */
+			pthread_mutex_lock(&batch.lock);
+			batch.ready = count;
+			pthread_cond_signal(&batch.changed);
+			pthread_mutex_unlock(&batch.lock);
+		}
+		pthread_mutex_lock(&batch.lock);
+		batch.finished = 1;
+		pthread_cond_broadcast(&batch.changed);
+		pthread_mutex_unlock(&batch.lock);
+		/* The caller also drains work; thread-creation failure is harmless. */
+		clone_batch_worker(&jobs[0]);
+		for (i = 1; i < workers; i++)
+			if (started[i] && pthread_join(threads[i], NULL))
+				die("unable to join APFS checkout worker");
+		pthread_cond_destroy(&batch.changed);
+		pthread_mutex_destroy(&batch.lock);
+		for (i = 0; i < count; i++) {
+			count_clone(&plans[i]);
+			if (plans[i].result > 0) {
+				prepared[i]->st = plans[i].st;
+				prepared[i]->status = PC_ITEM_WRITTEN;
+			} else if (plans[i].result < 0) {
+				errno = plans[i].saved_errno;
+				error_errno("unable to finalize APFS checkout of %s", prepared[i]->ce->name);
+				prepared[i]->status = PC_ITEM_FAILED;
+			}
+		}
+	}
+	return handled;
+#else
+	return 0;
+#endif
+}
+
+#else
+int apfs_checkout_batch(struct parallel_checkout_item *items, size_t nr,
+			const struct checkout *state, int workers)
+{
+	return 0;
+}
+
+int apfs_checkout_default_workers(void)
+{
+	return 1;
+}
+
+int apfs_checkout_clone(const struct cache_entry *ce, const char *path,
+		       const struct conv_attrs *ca,
+		       const struct checkout *state, struct stat *st)
+{
+	return 0;
+}
+#endif
